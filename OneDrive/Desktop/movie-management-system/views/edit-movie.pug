doctype html
html
  head
    title Edit Movie
    link(rel="stylesheet" href="/stylesheets/style.css")
  body
    .container
      h1 Edit Movie

      if errors.length > 0
        ul.error-list
          each error in errors
            li= error.msg

      form(action="/movies/" + movie._id + "/edit" method="POST")
        .form-group
          label Movie Name
          input(type="text" name="name" value=movie.name)

        .form-group
          label Description
          textarea(name="description")= movie.description

        .form-group
          label Year
          input(type="number" name="year" value=movie.year)

        .form-group
          label Genre
          input(type="text" name="genres" value=movie.genres)

        .form-group
          label Rating
          input(type="number" step="0.1" name="rating" value=movie.rating)

        button(type="submit") Update Movie

      .actions
        a.button-link(href="/movies/" + movie._id) Cancel