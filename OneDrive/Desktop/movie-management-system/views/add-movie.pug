doctype html
html
  head
    title Add Movie
    link(rel="stylesheet" href="/stylesheets/style.css")
  body
    .container
      h1 Add Movie

      if errors.length > 0
        ul.error-list
          each error in errors
            li= error.msg

      form(action="/movies/add" method="POST")
        .form-group
          label(for="name") Movie Name
          input(
            type="text"
            id="name"
            name="name"
            value=movie.name || ""
          )

        .form-group
          label(for="description") Description
          textarea(
            id="description"
            name="description"
          )= movie.description || ""

        .form-group
          label(for="year") Year
          input(
            type="number"
            id="year"
            name="year"
            value=movie.year || ""
          )

        .form-group
          label(for="genres") Genre
          input(
            type="text"
            id="genres"
            name="genres"
            value=movie.genres || ""
          )

        .form-group
          label(for="rating") Rating
          input(
            type="number"
            step="0.1"
            id="rating"
            name="rating"
            value=movie.rating || ""
          )

        button(type="submit") Add Movie

      .actions
        a.button-link(href="/movies") View Movies